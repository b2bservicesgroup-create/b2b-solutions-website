---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreas } from '../../data/serviceAreas.js';

const washingtonAreas = serviceAreas.filter((a) => a.region === 'washington');
const iowaAreas = serviceAreas.filter((a) => a.region === 'iowa');
---

<Layout
  title="Bookkeeping Service Areas"
  description="B2B Solutions provides professional bookkeeping services across Washington and Iowa. See all service areas."
>
  <Header />

  <main>
    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-200" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-blue-700 transition-colors">Home</a></li>
          <li><span class="mx-1">›</span></li>
          <li class="text-gray-900 font-medium">Service Areas</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
            Bookkeeping Services Across Washington & Iowa
          </h1>
          <p class="text-lg md:text-xl text-blue-100 leading-relaxed">
            B2B Solutions proudly serves small businesses in communities across Thurston County and Lewis County in Washington, and the Cedar Rapids metro and surrounding areas in Iowa. Find your city below to learn more about how we can help.
          </p>
        </div>
      </div>
    </section>

    <!-- Service Area Lists -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">

          <!-- Washington -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-blue-800 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">Washington</h2>
            </div>
            <p class="text-gray-600 mb-6">Serving Thurston County, Lewis County, and the surrounding southwest Washington region from our Rochester, WA office.</p>
            <ul class="space-y-3">
              {washingtonAreas.map(({ slug, city, stateAbbr, county }) => (
                <li>
                  <a
                    href={`/service-areas/${slug}`}
                    class="flex items-center justify-between bg-white rounded-xl px-5 py-4 shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all group"
                  >
                    <div>
                      <span class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors">{city}, {stateAbbr}</span>
                      <span class="block text-sm text-gray-500">{county}</span>
                    </div>
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-700 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Iowa -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-blue-800 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">Iowa</h2>
            </div>
            <p class="text-gray-600 mb-6">Serving the Cedar Rapids metro, the Iowa City corridor, and the Waterloo/Cedar Falls area from our Cedar Rapids, IA office.</p>
            <ul class="space-y-3">
              {iowaAreas.map(({ slug, city, stateAbbr, county }) => (
                <li>
                  <a
                    href={`/service-areas/${slug}`}
                    class="flex items-center justify-between bg-white rounded-xl px-5 py-4 shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all group"
                  >
                    <div>
                      <span class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors">{city}, {stateAbbr}</span>
                      <span class="block text-sm text-gray-500">{county}</span>
                    </div>
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-700 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Don't See Your City?</h2>
        <p class="text-lg text-gray-600 mb-8">
          We work with small businesses across Washington and Iowa — and in many cases we can support businesses remotely regardless of location. Reach out and let's talk.
        </p>
        <a href="/contact" class="bg-blue-800 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-900 transition-colors">
          Contact Us
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
