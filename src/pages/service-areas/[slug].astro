---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreas } from '../../data/serviceAreas.js';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const {
  city, state, stateAbbr, county, region, slug, inPerson, wbSlug,
  title, metaDescription, h1, intro, localRules, faqs, sources,
} = area;

const isWA = region === 'washington';
const phone = isWA ? '360-529-2672' : '319-451-0501';
const office = isWA ? { city: 'Rochester', abbr: 'WA' } : { city: 'Cedar Rapids', abbr: 'IA' };
const nearby = serviceAreas.filter((a) => a.region === region && a.slug !== slug);
const wbCityURL = wbSlug ? `https://washingtonbookkeeper.com/service-areas/${wbSlug}` : null;

// Washington pages lead with HR, payroll and Zoho (bookkeeping lives on WashingtonBookkeeper.com).
// Iowa pages include bookkeeping.
const services = [
  ...(isWA ? [] : [{
    title: 'Monthly Bookkeeping',
    desc: `Reconciled accounts and monthly statements for ${city} businesses, on flat plans starting at $250 a month.`,
    href: '/solutions/bookkeeping',
  }]),
  {
    title: 'Payroll Administration',
    desc: `On-time payroll through Cascade Payroll or Gusto, with ${isWA ? 'L&I, ESD, Paid Leave and WA Cares reporting' : 'Iowa withholding and Iowa Workforce Development reporting'} handled.`,
    href: '/solutions/payroll-administration',
  },
  {
    title: 'Fractional HR',
    desc: 'Offer letters, handbooks, leave policies and employee questions — HR expertise without a full-time hire.',
    href: '/solutions/hr-solutions',
  },
  {
    title: 'Zoho One Consulting',
    desc: 'Zoho CRM, Books, People and Flow set up around how your business actually runs.',
    href: '/solutions/zoho-consulting',
  },
];

const stateBasics = isWA
  ? 'Washington basics for 2026: the minimum wage is $17.13 an hour, Paid Family & Medical Leave premiums are 1.13% of wages (employers with fewer than 50 employees owe only the employee share), and L&I workers’ comp is reported quarterly by hours worked.'
  : 'Iowa basics for 2026: income tax is withheld at a flat 3.8%, the state minimum wage remains $7.25 an hour, and unemployment insurance is reported quarterly to Iowa Workforce Development.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'B2B Solutions',
  url: `https://b2bsolutions.biz/service-areas/${slug}`,
  telephone: phone,
  email: 'info@b2bsolutions.biz',
  address: {
    '@type': 'PostalAddress',
    addressLocality: office.city,
    addressRegion: office.abbr,
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'City',
    name: city,
    containedInPlace: { '@type': 'AdministrativeArea', name: `${county}, ${state}` },
  },
  description: metaDescription,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout title={title} description={metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main>
    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-200" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-blue-700 transition-colors">Home</a></li>
          <li><span class="mx-1">›</span></li>
          <li><a href="/service-areas" class="hover:text-blue-700 transition-colors">Service Areas</a></li>
          <li><span class="mx-1">›</span></li>
          <li class="text-gray-900 font-medium">{city}, {stateAbbr}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-white bg-opacity-10 rounded-full px-4 py-1.5 text-blue-100 text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-blue-300 shrink-0"></span>
            {county}, {stateAbbr} · {inPerson ? 'In person & remote' : 'Remote service'}
          </div>
          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">{h1}</h1>
          {intro.map((p) => (
            <p class="text-lg md:text-xl text-blue-100 leading-relaxed mb-4">{p}</p>
          ))}
          <div class="flex flex-wrap gap-4 mt-8">
            <a href="/contact" class="bg-white text-blue-800 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
              Get a Free Consultation
            </a>
            <a href={`tel:${phone.replace(/-/g, '')}`} class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-800 transition-colors">
              Call {phone}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Local rules -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          What's different about running a business in {city}
        </h2>
        <p class="text-lg text-gray-600 mb-10 max-w-2xl">
          The local rules and situations we see most with {city} employers.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {localRules.map(({ title, desc }) => (
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-2">{title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-gray-500 mt-6 max-w-3xl">{stateBasics}</p>
      </div>
    </section>

    <!-- Services -->
    <section class="py-16 md:py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10">
          How we help {city} businesses
        </h2>
        <div class={`grid grid-cols-1 sm:grid-cols-2 ${services.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'} gap-6`}>
          {services.map(({ title, desc, href }) => (
            <a href={href} class="block bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all">
              <h3 class="font-bold text-gray-900 mb-2">{title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{desc}</p>
            </a>
          ))}
        </div>
        {wbCityURL && (
          <div class="mt-8 bg-white rounded-xl p-6 border border-blue-100 max-w-3xl">
            <h3 class="font-bold text-gray-900 mb-2">Looking for a bookkeeper in {city}?</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Our Washington bookkeeping service has its own home.
              <a href={wbCityURL} class="text-blue-700 font-semibold hover:text-blue-800">See bookkeeping in {city} on WashingtonBookkeeper.com</a>.
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Questions from {city} business owners</h2>
        <div class="space-y-3">
          {faqs.map(({ question, answer }) => (
            <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
              <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-gray-900 hover:text-blue-700 transition-colors list-none">
                <span>{question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-100 pt-4">{answer}</div>
            </details>
          ))}
        </div>

        <div class="mt-10 text-xs text-gray-500">
          <p class="mb-2">Local rules checked October 2026. Rules change — confirm with the agency before acting. We don't prepare tax returns.</p>
          <ul class="space-y-1">
            {sources.map(({ label, url }) => (
              <li><a href={url} class="underline hover:text-blue-700" rel="noopener">{label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Nearby -->
    {nearby.length > 0 && (
      <section class="py-14 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Also serving {isWA ? 'Washington' : 'Linn County'}</h2>
          <div class="flex flex-wrap gap-2">
            {nearby.map((a) => (
              <a href={`/service-areas/${a.slug}`} class="bg-white text-gray-700 text-sm font-medium px-3 py-1.5 rounded-full border border-gray-200 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                {a.city}, {a.stateAbbr}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-16 md:py-20 bg-blue-800 text-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Talk to us about your {city} business</h2>
        <p class="text-blue-200 text-lg mb-8">
          {inPerson
            ? `Free consultation — at your place, ours in ${office.city}, or by video.`
            : 'Free consultation by phone or video.'}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="bg-white text-blue-800 px-8 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">Contact Us</a>
          <a href={`tel:${phone.replace(/-/g, '')}`} class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-800 transition-colors">Call {phone}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
