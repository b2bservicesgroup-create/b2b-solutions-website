---
import { serviceAreas } from '../data/serviceAreas.js';

interface Props {
  heading?: string;
  intro?: string;
  bg?: string;
}

const {
  heading = 'Areas We Serve',
  intro = 'We serve small businesses across Thurston and Lewis Counties in Washington and the Cedar Rapids corridor in Iowa, with offices in Rochester, WA and Cedar Rapids, IA — and remotely nationwide.',
  bg = 'bg-gray-50',
} = Astro.props;

const regions = [
  { name: 'Washington', note: 'Thurston County, Lewis County, and surrounding communities.', key: 'washington' },
  { name: 'Iowa', note: 'Cedar Rapids metro, Iowa City corridor, and Waterloo/Cedar Falls area.', key: 'iowa' },
];
---

<section class={`py-16 md:py-20 ${bg}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{heading}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{intro}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {regions.map(({ name, note, key }) => (
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="font-bold text-gray-900 text-lg mb-3">{name}</h3>
          <p class="text-sm text-gray-600 mb-4">{note}</p>
          <div class="flex flex-wrap gap-2">
            {serviceAreas.filter((a) => a.region === key).map((a) => (
              <a href={`/service-areas/${a.slug}`} class="bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1 rounded-full hover:bg-blue-100 transition-colors">{a.city}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/service-areas" class="inline-flex items-center text-blue-700 font-semibold hover:text-blue-800 transition-colors">
        View all service areas
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
