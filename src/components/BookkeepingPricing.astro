---
// Plan data mirrors WashingtonBookkeeper.com (the controlling site) — see src/data/bookkeepingPlans.ts.
import { plans, customPlan, everyPlanIncludes, addOns, payrollDisclosure, formatPrice } from '../data/bookkeepingPlans';

const WB_PRICING = 'https://washingtonbookkeeper.com/pricing';
---

<section id="pricing" class="py-16 md:py-20 bg-blue-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10">
      <p class="text-blue-700 text-sm font-semibold uppercase tracking-wider mb-2">Pricing</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Monthly bookkeeping plans</h2>
      <p class="text-gray-600 leading-relaxed">Flat monthly pricing based on how many accounts we keep reconciled. Every plan includes:</p>
      <ul class="mt-4 grid sm:grid-cols-2 gap-2">
        {everyPlanIncludes.map((item) => (
          <li class="flex items-start gap-2 text-sm text-gray-700">
            <svg class="w-4 h-4 text-blue-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {plans.map(({ name, price, tagline, features, featured }) => (
        <div class={`rounded-2xl p-7 flex flex-col ${featured ? 'bg-blue-800 text-white' : 'bg-white border border-gray-200'}`}>
          <h3 class={`font-bold text-lg ${featured ? 'text-white' : 'text-gray-900'}`}>{name}</h3>
          <p class={`text-sm mb-4 ${featured ? 'text-blue-200' : 'text-gray-500'}`}>{tagline}</p>
          <div class="flex items-baseline gap-1 mb-5">
            <span class={`text-4xl font-bold ${featured ? 'text-white' : 'text-gray-900'}`}>{price === null ? 'Quoted' : formatPrice(price)}</span>
            {price !== null && <span class={featured ? 'text-blue-200' : 'text-gray-500'}>/month</span>}
          </div>
          <ul class="space-y-2.5">
            {features.map((item) => (
              <li class={`flex items-start gap-2.5 text-sm ${featured ? 'text-blue-50' : 'text-gray-700'}`}>
                <svg class={`w-4 h-4 shrink-0 mt-0.5 ${featured ? 'text-blue-200' : 'text-blue-700'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-6 grid md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-1">{customPlan.name}</h3>
        <p class="text-sm text-gray-600">{customPlan.body}</p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h3 class="font-bold text-gray-900 mb-3">Add-ons and extras</h3>
        <ul class="space-y-2">
          {addOns.map(({ name, fee }) => (
            <li class="flex justify-between gap-4 text-sm">
              <span class="text-gray-700">{name}</span>
              <span class="font-semibold text-gray-900 text-right">{fee}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="text-gray-500 text-xs mt-6">
      *Payroll is administered through our partner <a href={payrollDisclosure.partnerURL} target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-700">{payrollDisclosure.partnerName}</a> and covers up to 5 employees; 6 or more need our <a href="/solutions/payroll-administration#pricing" class="underline hover:text-blue-700">HR &amp; Payroll package</a>. Final scope is set in your service agreement.
    </p>

    <div class="mt-8 bg-white rounded-2xl border border-blue-100 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-gray-700">
        <span class="font-semibold text-gray-900">Washington business?</span> Compare plans side by side and read our bookkeeping guides at WashingtonBookkeeper.com.
      </p>
      <a href={WB_PRICING} class="shrink-0 inline-flex justify-center bg-blue-800 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-blue-900 transition-colors">
        See full plan details
      </a>
    </div>
  </div>
</section>
